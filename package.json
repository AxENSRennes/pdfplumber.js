{
  "name": "pdfplumber-js",
  "version": "0.1.0",
  "type": "module",
  "description": "pdfplumber for JavaScript: extract chars, words, text, lines and tables from PDFs in the browser and Node, with the same results as Python pdfplumber.",
  "keywords": [
    "pdf",
    "pdfplumber",
    "pdfminer",
    "pdf-parser",
    "pdf-extraction",
    "text-extraction",
    "table-extraction",
    "tables",
    "webassembly",
    "wasm",
    "browser"
  ],
  "homepage": "https://github.com/AxENSRennes/pdfplumber.js#readme",
  "bugs": {
    "url": "https://github.com/AxENSRennes/pdfplumber.js/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AxENSRennes/pdfplumber.js.git"
  },
  "engines": {
    "node": ">=22.12"
  },
  "main": "./dist/src/index.js",
  "module": "./dist/src/index.js",
  "browser": "./dist/browser/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "browser": "./dist/browser/index.js",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./internal": {
      "types": "./dist/src/internal.d.ts",
      "browser": "./dist/browser/internal.js",
      "import": "./dist/src/internal.js",
      "default": "./dist/src/internal.js"
    },
    "./worker": "./dist/browser/worker.js",
    "./pdfplumber.wasm": "./dist/pdfplumber.wasm",
    "./cmaps/*": "./dist/cmaps/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src",
    "dist/browser",
    "dist/pdfplumber.wasm",
    "dist/cmaps",
    "docs/public-api.md",
    "docs/js-runtime.md",
    "THIRD_PARTY_NOTICES"
  ],
  "sideEffects": [
    "./dist/src/index.js",
    "./dist/src/browser.js",
    "./dist/browser/*.js"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:cmaps": "node scripts/build-cmaps.mjs",
    "build:js": "node scripts/build-js.mjs",
    "test:js": "vitest run --config js/vitest.config.ts",
    "test:browsers": "scripts/check-browsers.sh",
    "typecheck": "tsc -p js/tsconfig.test.json",
    "size": "node scripts/size.mjs",
    "bench:encoding": "node js/bench/node.mjs",
    "bench:encoding:browsers": "node js/bench/browsers.mjs",
    "corpus:download": "node scripts/download-corpus.mjs",
    "corpus:micro": "uv run python oracle/generate_micro_pdfs.py"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.15.3",
    "binaryen": "123.0.0",
    "esbuild": "^0.25.12",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
