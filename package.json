{
  "name": "pdfplumber-js",
  "version": "0.0.0",
  "type": "module",
  "description": "pdfplumber for JavaScript: a faithful Rust/Wasm port of pdfplumber and pdfminer.six, verified against Python.",
  "main": "./dist/src/index.js",
  "module": "./dist/src/index.js",
  "browser": "./dist/browser/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "browser": "./dist/browser/index.js",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "dist/browser",
    "docs/public-api.md"
  ],
  "scripts": {
    "corpus:download": "node scripts/download-corpus.mjs",
    "corpus:micro": "uv run python oracle/generate_micro_pdfs.py"
  },
  "dependencies": {},
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.15.3",
    "esbuild": "^0.25.12",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
